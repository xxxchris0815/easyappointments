# Copy this file to `.env.prod` and replace every <PLACEHOLDER>.
# Do not commit `.env.prod`.

# Public HTTP port mapped to nginx
APP_PORT=8080

# Host/container timezone (PHP date() / logs). Appointment emails use
# Settings → default_timezone (e.g. Europe/Berlin), not this value alone.
TZ=Europe/Berlin

# How often the reminders worker runs (seconds)
REMINDER_INTERVAL_SECONDS=60

# MySQL credentials (must match config.php DB_* values)
MYSQL_DATABASE=easyappointments
MYSQL_USER=<DB_APP_USERNAME>
MYSQL_PASSWORD=<DB_APP_PASSWORD>
MYSQL_ROOT_PASSWORD=<DB_ROOT_PASSWORD>
